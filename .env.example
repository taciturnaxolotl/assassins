# Google OAuth — console.cloud.google.com > Credentials > OAuth client (Web).
# Authorized redirect URIs:
#   http://localhost:5173/auth/callback
#   https://<your-domain>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# polar.sh — sandbox while testing. Without these everyone stays on the free
# tier and the app still runs.
#
# The access token needs four scopes, and no more:
#   checkouts:write           to send somebody to the checkout
#   customer_sessions:write   the customer portal
#   orders:read               to see that a one-off purchase settled
#   customers:read            to read a customer's subscription state
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
POLAR_PRODUCT_ID=

# Cedarville usernames (the part before @cedarville.edu) who get the queue.
ADMIN_USERNAMES=

# Only when the public origin is not what the server sees — a tunnel back to
# localhost, say. Leave unset in production.
# ORIGIN=https://assassins.bore.dunkirk.sh

# GroupMe — reading the kills topic on the queue page. Without these the whole
# feature is absent. The token is `access_token` in web.groupme.com's
# localStorage, or yours from dev.groupme.com.
#
# GROUPME_KILLS_TOPIC is the *topic* id, the second number in a URL like
# web.groupme.com/chats/group/<group>/<topic>. A topic is not readable as a
# group — GET /v3/groups/<topic> is a 404 — but its messages are read at the
# ordinary group route, which is what this uses.
GROUPME_TOKEN=
GROUPME_GROUP=117059227
GROUPME_KILLS_TOPIC=117059270
# The snipes topic. Photographs posted here that are a name and nothing else
# file themselves against that player; anything wordier waits in the queue.
GROUPME_SNIPES_TOPIC=117105569
