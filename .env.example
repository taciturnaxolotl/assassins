# Google OAuth — console.cloud.google.com > Credentials > OAuth client (Web).
# Authorized redirect URIs:
#   http://localhost:5173/auth/callback
#   https://<your-domain>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# polar.sh — sandbox while testing. Without these everyone stays on the free
# tier and the app still runs.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
POLAR_PRODUCT_ID=

# Cedarville usernames (the part before @cedarville.edu) who get the queue.
ADMIN_USERNAMES=

# Only when the public origin is not what the server sees — a tunnel back to
# localhost, say. Leave unset in production.
# ORIGIN=https://assassins.bore.dunkirk.sh
