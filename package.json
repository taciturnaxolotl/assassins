{
  "name": "assassins",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "bun scripts/build.mjs",
    "data:remote": "bun scripts/build.mjs --remote",
    "galleries": "bun scripts/fetch-galleries.mjs",
    "photos:hash": "bun scripts/hash-photos.mjs",
    "og": "bun scripts/og-image.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && wrangler dev",
    "deploy": "bun run db:migrate:remote && vite build && wrangler deploy",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply assassins --local",
    "db:migrate:remote": "CLOUDFLARE_ACCOUNT_ID=fdbe5b542ede643d34962c1f07a34565 wrangler d1 migrations apply assassins --remote",
    "cf-typegen": "wrangler types ./src/worker-configuration.d.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.42.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "drizzle-kit": "^0.31.10",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6",
    "vite": "^8.2.2",
    "wrangler": "^4.129.1"
  },
  "dependencies": {
    "@polar-sh/sdk": "^0.49.0",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "standardwebhooks": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1"
  }
}
